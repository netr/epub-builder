<?xml version="1.0" encoding="UTF-8"?>
<package version="2.0" xmlns="http://www.idpf.org/2007/opf" unique-identifier="epub-id-1">
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:opf="http://www.idpf.org/2007/opf">
    <dc:identifier id="epub-id-1">{{uuid}}</dc:identifier>{% if publisher %}
    <dc:publisher>{{publisher}}</dc:publisher>{% endif %}
    <dc:title id="title">{{title}}</dc:title>{% if date_published %}
    <dc:date>{{date_published}}</dc:date>{% endif %}{% if isbn %}
    <dc:identifier id="pub-id" opf:scheme="ISBN">{{isbn}}</dc:identifier>{% endif %}
    <dc:language>{{lang}}</dc:language>{% if author %}{% for a in author %}
    <dc:creator opf:file-as="{{a.name_last_first}}" opf:role="aut">{{a.name}}</dc:creator>{% endfor %}{% endif %}
{{optional}}{% if generator_attr %}
    <meta name="generator" content="{{generator_attr}}" />{% endif %}{% if lacuna_version %}
    <meta name="lacuna-version" content="{{lacuna_version}}" />{% endif %}{% if lacuna_target_platform %}
    <meta name="lacuna-target-platform" content="{{lacuna_target_platform}}" />{% endif %}
  </metadata>
  <manifest>
    <item id="ncx" href="toc.ncx" media-type="application/x-dtbncx+xml"/>
    <item id="nav" href="nav.xhtml" media-type="application/xhtml+xml"/>
{{items}}
  </manifest>
  <spine toc="ncx">
{{itemrefs}}
  </spine>
  <guide>
    <reference type="toc" title="{{toc_name_attr}}" href="nav.xhtml"/>
{{guide}}
  </guide>
</package>
