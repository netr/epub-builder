<?xml version="1.0" encoding="UTF-8"?>
<package version="3.0" xmlns="http://www.idpf.org/2007/opf" unique-identifier="epub-id-1">
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:opf="http://www.idpf.org/2007/opf">
    <dc:identifier id="epub-id-1">{{uuid}}</dc:identifier>{% if publisher %}
    <dc:publisher>{{publisher}}</dc:publisher>{% endif %}
    <dc:title id="title">{{title}}</dc:title>{% if date_published %}
    <dc:date>{{date_published}}</dc:date>{% endif %}{% if isbn %}
    <dc:identifier id="pub-id" opf:scheme="ISBN">{{isbn}}</dc:identifier>{% endif %}
    <dc:language>{{lang}}</dc:language>{% if author %}{% for a in author %}
    <dc:creator id="creator">{{a.name}}</dc:creator>
    {% endfor %}{% endif %}
{{optional}}
    <meta property="dcterms:modified">{{date_modified}}</meta>
    <meta property="ibooks:version">1.0.0</meta>
    <meta property="ibooks:specified-fonts">true</meta>
    <meta property="rendition:layout">reflowable</meta>
    <meta property="rendition:spread">none</meta>
    <meta property="rendition:orientation">auto</meta>
    <meta property="ibooks:iphone-orientation-lock">none</meta>
    <meta property="ibooks:ipad-orientation-lock">none</meta>
  </metadata>
  <manifest>
    <item id="ncx" href="toc.ncx" media-type="application/x-dtbncx+xml"/>
    <item id="nav" href="nav.xhtml" media-type="application/xhtml+xml" properties="nav"/>
{{items}}
  </manifest>
  <spine toc="ncx" page-progression-direction="{{direction}}">
{{itemrefs}}
  </spine>
  <guide>
{{guide}}
  </guide>
</package>